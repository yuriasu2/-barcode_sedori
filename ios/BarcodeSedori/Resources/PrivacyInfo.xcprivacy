<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <true/>
    <!-- AdMob(Google Mobile Ads SDK)が接続するトラッキングドメイン。
         Googleは公式リストを公開していないため、Instrumentsの Points of Interest で
         「is not listed in your app's NSPrivacyTrackingDomain key」と警告されたドメインを
         実測して列挙している(2026-08-14計測)。
         ここに書いたドメインは、ATT未許可のユーザーに対してOSが接続を遮断する点に注意。
         広告SDKを追加・変更したときは再計測すること。 -->
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <string>googleads.g.doubleclick.net</string>
        <string>g.doubleclick.net</string>
        <string>www.googleadservices.com</string>
        <string>pagead2.googlesyndication.com</string>
    </array>
    <!-- 収集データはアプリ自身のものに加え、組み込んでいるSDKが申告しているものも含める必要がある。
         下記2件はPostHog SDK同梱のPrivacyInfo.xcprivacyの申告内容に合わせたもの
         (2026-08-14にSDK実物を確認)。PostHogはIDFAを一切参照せず、SDK自身も
         NSPrivacyCollectedDataTypeTracking=falseと申告しているため、ATTの許可対象外
         (Appleの言う「トラッキング」= 他社アプリ/サイトのデータと紐付けた個人識別 に当たらない)。
         このアプリ側もdistinct_idを設定せず匿名IDのままにしている(Analytics.swift参照)。 -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUsageData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
