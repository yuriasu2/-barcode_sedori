<mxfile host="app.diagrams.net">
  <diagram name="SP-API認可（2026-09-09）" id="spapi-auth">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="app" value="セラーレンズ iOS&#xa;AmazonAuthorizationSession&#xa;検証後にKeychain保存" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="session" value="Apple ASWebAuthenticationSession&#xa;開始元アプリの完了ハンドラへ返す&#xa;通常のonOpenURLでは保存しない" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="worker" value="Cloudflare Workers / api.sellira.jp&#xa;/oauth/login → state署名・認可画面へ&#xa;/oauth/callback → LWAトークン交換&#xa;トークンはDBへ永続化しない" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="amazon" value="Amazon Seller Central / LWA&#xa;販売パートナーがアクセスを許可" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="start" value="認可開始" edge="1" parent="1" source="app" target="session" style="endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="https" value="HTTPS / 認可ページ表示" edge="1" parent="1" source="session" target="worker" style="endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lwa" value="認可コード / HTTPSトークン交換" edge="1" parent="1" source="worker" target="amazon" style="endArrow=classic;startArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="return" value="barcodesedori://spapi-auth&#xa;refresh_token + selling_partner_id&#xa;セッションがコールバックを受信" edge="1" parent="1" source="worker" target="session" style="endArrow=classic;edgeStyle=orthogonalEdgeStyle;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="350"/><mxPoint x="340" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="今回の変更範囲: iOSの認可受信経路。サーバーは既存仕様。&#xa;Universal Links / PKCE / 短命コードは未導入。URLとHTMLへのトークン埋め込みは残る。&#xa;図はSP-API認可に限定。新ビルド配信前の実装を示す。" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1000" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="billing" name="Pro購入検証（本番反映済）">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="b-ios" value="iOS / StoreKit 2&#xa;購入・復元・前面復帰&#xa;JWS / appAccountToken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="b-keychain" value="端末Keychain&#xa;匿名セッション・API資格&#xa;サーバーAPI資格とローカルProは別管理" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="b-worker" value="Cloudflare Workers / api.sellira.jp&#xa;Apple公式ライブラリ・信頼ルート&#xa;/api/billing/session, verify, refresh&#xa;/api/apple/notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="b-do" value="BillingDO（新規）&#xa;環境＋originalTransactionId単位&#xa;購読状態・通知重複・照会直列化&#xa;別インスタンス: 入口制限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="410" y="320" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="b-apple" value="Apple&#xa;App Store Server API&#xa;Server Notifications V2&#xa;Production / Sandbox&#xa;通知V2: 本番APIに登録済・両環境配送成功" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="b-api" value="検索・グラフ・出品API&#xa;署名付き資格＋セッションでPro判定&#xa;既存無料枠DO / Keepaスロットルを維持" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="b-e1" value="JWS / HTTPS&#xa;資格は最長15分" edge="1" parent="1" source="b-ios" target="b-worker" style="endArrow=classic;startArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" edge="1" parent="1" source="b-ios" target="b-keychain" style="endArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" value="検証・保存" edge="1" parent="1" source="b-worker" target="b-do" style="endArrow=classic;startArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" value="購読照会 / 署名付き通知&#xa;OCSP失効確認: 標準fetchアダプター" edge="1" parent="1" source="b-worker" target="b-apple" style="endArrow=classic;startArrow=classic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e5" value="検証済みPro" edge="1" parent="1" source="b-worker" target="b-api" style="endArrow=classic;edgeStyle=orthogonalEdgeStyle;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-staging" value="検証Worker（2026-09-10公開）&#xa;barcode-sedori-api-staging&#xa;.saastids2025.workers.dev&#xa;4つのDOは本番と独立 / 課金Secrets登録済" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="b-note" value="本番: health/session 200、購入検証コード反映済。検証環境: Sandbox購入・Pro反映確認済。&#xa;Apple API鍵とAPI資格署名鍵は別のWorker Secrets。生JWSはサーバーへ永続保存しない。&#xa;本番通知後の既発行資格は最長15分残る。Sandboxの検証済みProはProductionと同じ無制限利用資格。" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1050" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
