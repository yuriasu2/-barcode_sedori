{
  "name": "barcode-sedori-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*", "/oauth/*"]
  },
  // 本番ドメイン。CloudflareがDNSレコードとTLS証明書を自動作成する。
  // アプリはこのURLを参照するため、将来サーバーを移してもアプリ更新が不要になる。
  "routes": [
    { "pattern": "api.sellira.jp", "custom_domain": true }
  ],
  "vars": {
    // 秘密ではない公開識別子。コード側にも同じ既定値があるが意図を明示するため置く。
    "MARKETPLACE_ID": "A1VC38T7YXB528",
    "SPAPI_ENDPOINT": "https://sellingpartnerapi-fe.amazon.com",
    // 無料枠ユニットモデル(deviceQuota.js)。
    // 基本の1日あたりユニット数 / 広告視聴1本あたりの付与ユニット数 / 1日の上限(cap)。
    "BASE_DAILY_UNITS": "5",
    "UNITS_PER_AD": "5",
    "MAX_DAILY_UNITS": "100",
    // Keepaスロットル(keepaThrottle.js)。契約プランの毎分トークン数。
    // 枯渇時に待たせるキューは撤去済み(2026-08-03)なので、キュー深さ/タイムアウトの
    // 環境変数は無い。適応ブレーキの上限はコード内定数(BRAKE_CAP_MS)。
    // プランを20トークン/分へ上げたらここだけ更新してデプロイする。
    "KEEPA_REFILL_PER_MIN": "5"
  },
  // 広告配信設定(/api/ads)を置くKV namespace。id は namespace 作成後に埋める
  // (`wrangler kv namespace create ADS_CONFIG`)。id未設定(プレースホルダ)のままでも
  // routes.js側はglobalThis.__adsKv未設定として安全側({version:0,slots:{}})に倒れる。
  "kv_namespaces": [
    { "binding": "ADS_CONFIG", "id": "f476a5086dc0496a90d4f07ced0e14af" }
  ],
  // 無料枠ユニット(deviceQuota.js)の永続化先。デバイスID単位でDOインスタンスを1個割り当てる。
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_QUOTA", "class_name": "DeviceQuotaDO" },
      { "name": "KEEPA_THROTTLE", "class_name": "KeepaThrottleDO" }
    ]
  },
  // new_sqlite_classes を使う(new_classes ではない)。無料プランではSQLiteバックエンドの
  // Durable Objectsのみ利用可能なため(KVバックエンドは有料プラン専用)。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceQuotaDO"] },
    { "tag": "v2", "new_sqlite_classes": ["KeepaThrottleDO"] }
  ]
  // Secrets(LWA_CLIENT_ID/LWA_CLIENT_SECRET/KEEPA_API_KEY/SPAPI_APP_ID)は
  // `wrangler secret put` で登録する(このファイルに書かない)。
  // LWA_REFRESH_TOKEN はどの環境にも置かない(BYO前提)。
}
