{
  "name": "barcode-sedori-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*", "/oauth/*"]
  },
  // 本番ドメイン。CloudflareがDNSレコードとTLS証明書を自動作成する。
  // アプリはこのURLを参照するため、将来サーバーを移してもアプリ更新が不要になる。
  "routes": [
    { "pattern": "api.sellira.jp", "custom_domain": true }
  ],
  "vars": {
    // 秘密ではない公開識別子。コード側にも同じ既定値があるが意図を明示するため置く。
    "MARKETPLACE_ID": "A1VC38T7YXB528",
    "SPAPI_ENDPOINT": "https://sellingpartnerapi-fe.amazon.com",
    // 無料枠ユニットモデル(deviceQuota.js)。
    // 基本の1日あたりユニット数 / 広告視聴1本あたりの付与ユニット数 / 1日の上限(cap)。
    // 実際に使う値は ADS_CONFIG KV の quota-limits キー(JSON)が優先される
    // (デプロイなしで調整するため。quotaLimits.js参照)。ここの値はKV未設定・
    // JSON破損・値が不正なときのフォールバックとして残している。
    "BASE_DAILY_UNITS": "5",
    "UNITS_PER_AD": "5",
    "MAX_DAILY_UNITS": "100",
    // Keepaスロットル(keepaThrottle.js)。契約プランの毎分トークン数。
    // 枯渇時に待たせるキューは撤去済み(2026-08-03)なので、キュー深さ/タイムアウトの
    // 環境変数は無い。適応ブレーキの上限はコード内定数(BRAKE_CAP_MS)。
    // プランを20トークン/分へ上げたらここだけ更新してデプロイする。
    "KEEPA_REFILL_PER_MIN": "5",
    // 共有Keepaキーを消費するリクエストの、クライアントIP単位のレート制限(回/分)。
    // アプリ側の検索クールダウンはクライアント実装のためcurlには効かない。
    // 値は共有キー自体の補充レート(KEEPA_REFILL_PER_MIN=5トークン/分)にあえて
    // 近づけてある。補充レートより大きく上に離すと、結局は単一の発信元がキーを
    // 独占できてしまい抑止にならないため。トレードオフとして、CGNAT(同一IPを
    // 複数の正規ユーザーが共有する場合)や自前Keepaキー利用者の高速スキャンでは
    // この制限に当たり得ることを許容する。
    "IP_RATE_LIMIT_PER_MIN": "20",
    // グラフ生データ(/api/graph-data)のキャッシュTTL(ミリ秒)。既定6時間。
    // グラフは「現在価格」ではなく価格履歴の表示なので、検索結果(30分)ほど鮮度が要らない。
    // 短くすると共有Keepaトークンの消費が増える。伸ばすと当日の値動きの反映が遅れる。
    "GRAPH_CACHE_TTL_MS": "21600000",
    // 出品者ID単位のPro無料お試し期間(sellerTrial.js)の日数。
    // サーバーが唯一の権威(seller ID + サーバー自身の時計)で判定するため、
    // クライアント側の時計操作・再インストールでは延長も再取得もできない。
    "SPAPI_TRIAL_DAYS": "7"
  },
  // 広告配信設定(/api/ads)を置くKV namespace。id は namespace 作成後に埋める
  // (`wrangler kv namespace create ADS_CONFIG`)。id未設定(プレースホルダ)のままでも
  // routes.js側はglobalThis.__adsKv未設定として安全側({version:0,slots:{}})に倒れる。
  "kv_namespaces": [
    { "binding": "ADS_CONFIG", "id": "f476a5086dc0496a90d4f07ced0e14af" }
  ],
  // 無料枠ユニット(deviceQuota.js)の永続化先。デバイスID単位でDOインスタンスを1個割り当てる。
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_QUOTA", "class_name": "DeviceQuotaDO" },
      { "name": "KEEPA_THROTTLE", "class_name": "KeepaThrottleDO" },
      { "name": "IP_RATE_LIMIT", "class_name": "IpRateLimitDO" },
      { "name": "SELLER_TRIAL", "class_name": "SellerTrialDO" }
    ]
  },
  // new_sqlite_classes を使う(new_classes ではない)。無料プランではSQLiteバックエンドの
  // Durable Objectsのみ利用可能なため(KVバックエンドは有料プラン専用)。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceQuotaDO"] },
    { "tag": "v2", "new_sqlite_classes": ["KeepaThrottleDO"] },
    { "tag": "v3", "new_sqlite_classes": ["IpRateLimitDO"] },
    { "tag": "v4", "new_sqlite_classes": ["SellerTrialDO"] }
  ]
  // Secrets(LWA_CLIENT_ID/LWA_CLIENT_SECRET/KEEPA_API_KEY/SPAPI_APP_ID/OAUTH_STATE_SECRET/
  // ADMIN_TOKEN)は `wrangler secret put` で登録する(このファイルに書かない)。
  // OAUTH_STATE_SECRET: oauth.jsのstate署名(HMAC-SHA256)専用の鍵。他secretと使い回さない。
  // 未設定だと/oauth/loginは503で拒否される(oauth.js参照)。
  // ADMIN_TOKEN: POST /api/admin/quota-reset(開発者向け、無料枠クォータのリセット)専用の
  // 固定トークン。X-Admin-Tokenヘッダーで照合する。未設定だと常に503で拒否する
  // (routes.js の isAdminAuthorized参照)。iOSのDEBUGビルド(SettingsView「開発者向け」)に
  // 同じ値をハードコードして使う(Releaseビルドには含まれない。RewardedAdManagerの
  // fallbackUnitIdと同じ扱い)。他secretと使い回さないこと。
  // LWA_REFRESH_TOKEN はどの環境にも置かない(BYO前提)。
}
